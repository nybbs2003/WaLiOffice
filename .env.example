# WaLiOffice 配置示例
# 复制为 .env 后再启动服务：cp .env.example .env

AIPPT_APP_NAME="WaLiOffice"
AIPPT_HOST=0.0.0.0
AIPPT_PORT=8000

# 必填：生产环境必须使用足够长、随机的密钥
AIPPT_JWT_SECRET=change-me-to-a-long-random-secret
AIPPT_JWT_EXPIRY_HOURS=24

# 公众号验证码登录：复用 x-api 登录校验接口
WALIOFFICE_X_API_AUTH_LOGIN_URL=https://x-api.itedus.cn/api/v1/auth/login

# ── 模型配置（全部可选，默认空）──
# 只有 AIPPT_JWT_SECRET 是必填的。模型配置可以完全交给用户在设置页自行填写，
# 无需在启动前配置这些环境变量（多租户场景下每个用户配自己的）。
# 若在环境变量里填了，会作为「启动默认值」，用户未配置时回退到这些 env。
LLM_TEXT_BASE_URL=
LLM_TEXT_API_KEY=
LLM_TEXT_MODELS=
# LLM_TEXT_MODELS_DEFAULT=

LLM_IMAGE_BASE_URL=
LLM_IMAGE_API_KEY=
LLM_IMAGE_MODELS=
# LLM_IMAGE_MODELS_DEFAULT=

LLM_VIDEO_BASE_URL=
LLM_VIDEO_API_KEY=
LLM_VIDEO_MODELS=
# LLM_VIDEO_MODELS_DEFAULT=

AIPPT_LLM_PROVIDER=glm-gateway
AIPPT_LLM_TOOL_TIMEOUT_MS=1800000
AIPPT_LLM_CHAT_TIMEOUT_MS=1800000

# 联网搜索源：auto | searxng | duckduckgo
AIPPT_WEB_SEARCH_PROVIDER=auto
# 当 provider=searxng 或 auto 时，会尝试这个地址
AIPPT_WEB_SEARCH_ENDPOINT=http://127.0.0.1:8080
AIPPT_WEB_SEARCH_TIMEOUT_MS=20000

# 数据目录
AIPPT_DATA_DIR=data
AIPPT_PROJECTS_DIR=data/projects
AIPPT_SESSIONS_DIR=data/sessions
AIPPT_RENDER_OUTPUT_DIR=outputs

# CORS
AIPPT_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# 数据库配置（可选）migrations/001_init_mysql.sql 自己创建一个名称为 walioffice 的数据库，导入建表语句。之后配置相关连接信息。
# 不配 DATABASE_URL 时默认使用 SQLite（data/walioffice.db）
# 配置 MySQL 示例：
# DATABASE_URL=mysql://user:password@localhost:3306/walioffice
# DB_MAX_CONNECTIONS=8
DATABASE_URL=
DB_MAX_CONNECTIONS=8

# 多租户：是否开放自动注册（false 时仅允许首个用户注册为超管，其余需邀请码）
ALLOW_REGISTER=true

# 飞书 OAuth 登录（可选，单实例多用户场景推荐）
# 配置后前端「飞书账号登录」按钮生效
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 飞书授权回调地址（需与飞书开放平台配置一致，如 https://your-domain/login）
FEISHU_REDIRECT_URI=
